# {{ domain }} — static landing page, served straight off this host.

server {
  listen      80;
  listen   [::]:80;
  server_name {{ domain }};

  location /.well-known/acme-challenge {
    root {{ srv_dir }}/.letsencrypt;
  }

{% if cert_exists %}
  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen      443 ssl http2;
  listen [::]:443 ssl http2;
  server_name {{ domain }};

  ssl_certificate         /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
  ssl_certificate_key     /etc/letsencrypt/live/{{ domain }}/privkey.pem;
  ssl_trusted_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
  ssl_session_cache shared:SSL:50m;
  ssl_session_timeout 1h;
  ssl_stapling on;
  ssl_stapling_verify on;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;
  ssl_dhparam /etc/nginx/dhparams.pem;

  access_log /var/log/nginx/{{ domain | replace('.', '-') }}.log;
  error_log /var/log/nginx/{{ domain | replace('.', '-') }}-error.log error;

  root {{ srv_dir }}/public;
  index index.html;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  gzip on;
  gzip_types text/css application/javascript application/xml image/svg+xml;
  gzip_min_length 1024;

  # index.html carries the canonical tag and the OG data: never serve it stale
  location = / {
    add_header Cache-Control "public, max-age=300" always;
    try_files /index.html =404;
  }

  location /vendor/ {
    add_header Cache-Control "public, max-age=604800" always;
  }

  location / {
    try_files $uri $uri/ =404;
  }
}
{% else %}
  # HTTP-only until the certificate exists; certbot needs the vhost live first.
  location / {
    return 503;
  }
}
{% endif %}
